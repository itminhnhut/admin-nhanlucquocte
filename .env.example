# Base URL API của trường. Phải có /api ở cuối: route nằm dưới /api/client/* và /api/admin/*.
VITE_API_URL=https://api.trungcapnhanlucquocte.vn/api/

# Gọi website tạo lại sitemap.xml sau khi đăng bài (để trống → không gọi).
# Khi web NLQT lên domain: https://trungcapnhanlucquocte.vn/sitemap/refresh?key=<SITEMAP_KEY>
# Key lấy từ biến SITEMAP_KEY đặt trên EasyPanel của website.
VITE_SITEMAP_REFRESH_URL=https://trungcapnhanlucquocte.vn/sitemap/refresh?key=<SITEMAP_KEY>

# Public URL của chính trang quản trị
VITE_APP_URL=https://admin.trungcapnhanlucquocte.vn
