# Base URL API backend.
# Khi trường có backend riêng: https://api.trungcapnhanlucquocte.vn/api/
#
# TẠM THỜI đang dùng API của Việt Úc (xem .env của máy local) để admin chạy được.
# ⚠️ Dùng API đó thì mọi thao tác Lưu / Xoá ghi vào database THẬT của Việt Úc.
# Không đặt sẵn giá trị ở đây để người clone repo không vô tình sửa dữ liệu trường khác.
VITE_API_URL=

VITE_APP_URL=https://admin.trungcapnhanlucquocte.vn

# Gọi website tạo lại sitemap.xml sau khi đăng bài (để trống → không gọi).
# Khi web NLQT lên domain: https://trungcapnhanlucquocte.vn/sitemap/refresh?key=<SITEMAP_KEY>
# Key lấy từ biến SITEMAP_KEY đặt trên EasyPanel của website.
VITE_SITEMAP_REFRESH_URL=
